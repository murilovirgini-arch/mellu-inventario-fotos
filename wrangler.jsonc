{
 "name": "mellu-inventario-livre",
 "main": "worker/index.mjs",
 "compatibility_date": "2026-10-29",
 "compatibility_flags": ["nodejs_compat"],
 "workers_dev": true,
 "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
 "d1_databases": [{"binding":"DB","database_name":"mellu-inventario-livre","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
 "vars": {"GEMINI_FREE_TIER_CONFIRMED":"false"},
 "observability": {"enabled":false}
}
